# ==========================================
# LA POSH NAILS STUDIO & ACADEMY - ENV CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/laposh?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/laposh_db

# Security & Authentication
JWT_SECRET=laposh_super_secret_jwt_key_beauty_2026_change_in_production
JWT_EXPIRES_IN=7d
ADMIN_SETUP_SECRET=laposh_bootstrap_admin_secret_key_2026

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Notifications (Nodemailer - Configurable SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="La Posh Studio & Academy" <no-reply@laposh.com>
ADMIN_NOTIFICATION_EMAIL=admin@laposh.com

# WhatsApp Direct Contact Number (with country code, no + or spaces)
WHATSAPP_BUSINESS_NUMBER=919512348787

# Client (Vite) Environment Configuration
# Put in client/.env or client/.env.production
# VITE_API_BASE_URL=http://localhost:5000/api
